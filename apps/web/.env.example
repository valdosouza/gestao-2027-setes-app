# Copie para .env e ajuste. Rode com: .\run-dev.ps1 (na pasta apps/web)
# WEB_PORT: porta do dev server Flutter (flag --web-port)
# API_URL: endereço da setes-api (vira dart-define; AppConfig.baseApiUrl)
# NFSE_API_URL: endereço da nfse-api (D-F4/D-F146 — OBRIGATÓRIA; sem ela o app abre só a tela de erro de configuração)
WEB_PORT=5051
API_URL=http://localhost:3000
NFSE_API_URL=http://localhost:3002
